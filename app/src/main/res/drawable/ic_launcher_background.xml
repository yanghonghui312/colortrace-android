<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标 · 背景层（满幅 108×108，浅色/深色遮罩下都不该露透明）。
  画布底 = 中性深灰（调色工作区纪律）+ 琥珀辉光（呼应欢迎页 hero 卡片）。
  与 android/icon/colortrace-icon.svg 的 #bg_layer 逐字对应。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="108">
                <item android:offset="0" android:color="#FF262A30" />
                <item android:offset="1" android:color="#FF121316" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="56"
                android:gradientRadius="50">
                <item android:offset="0" android:color="#38E8A854" />
                <item android:offset="0.55" android:color="#14E8A854" />
                <item android:offset="1" android:color="#00E8A854" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
